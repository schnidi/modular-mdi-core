/*
 * Theme Name: Enterprise Office - Clean Flat MDI
 * Version: 1.5.0
 * Author: VenvHub Team
 */

/* =================================================================== */
/* GLOBÁLNE NASTAVENIA                                                 */
/* =================================================================== */

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #1E293B;
    background-color: transparent;
    font-size: 12px;
}

/* =================================================================== */
/* HLAVNÉ OKNO A MDI PRACOVNÁ PLOCHA                                   */
/* =================================================================== */

#MainWindow,
#AboutDialog {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
}

QMdiArea {
    background-color: #E2E8F0;
    border: none;
}

/* =================================================================== */
/* MDI POD-OKNÁ (VONKAJŠÍ OBVODOVÝ RÁM)                                */
/* =================================================================== */

QMdiSubWindow {
    background-color: transparent;
    border: none;
}

/* Neaktívne MDI okno */
QMdiSubWindow > QWidget {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 0px;
}

QMdiSubWindow #CustomTitleBar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

QMdiSubWindow #CustomTitleBar QLabel#lbl_title {
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
    padding-left: 6px;
    background: transparent;
}

/* Aktívne MDI okno */
QMdiSubWindow[active="true"] > QWidget,
QMdiSubWindow > QWidget[active="true"] {
    background-color: #FFFFFF;
    border: 1px solid #0066CC;
    border-radius: 0px;
}

QMdiSubWindow[active="true"] #CustomTitleBar,
QMdiSubWindow #CustomTitleBar[active="true"] {
    background-color: #FFFFFF;
    border-bottom: 1px solid #0066CC;
}

QMdiSubWindow[active="true"] #CustomTitleBar QLabel#lbl_title,
QMdiSubWindow #CustomTitleBar[active="true"] QLabel#lbl_title {
    color: #0066CC;
    font-size: 12px;
    font-weight: 600;
    padding-left: 6px;
    background: transparent;
}

/* =================================================================== */
/* TITULKOVÁ LIŠTA HLAVNÉHO OKNA                                       */
/* =================================================================== */

#MainWindow > #CustomTitleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

#MainWindow > #CustomTitleBar QLabel#lbl_title {
    color: #0F172A;
    font-size: 12px;
    font-weight: 600;
    padding-left: 6px;
    background: transparent;
}

/* =================================================================== */
/* BEŽNÉ FORMULÁROVÉ TLAČIDLÁ V OBSAHU (ZADEFINOVANÉ PRVÉ)             */
/* =================================================================== */

QPushButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    padding: 5px 14px;
    border-radius: 3px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #0066CC;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

/* =================================================================== */
/* LIŠTOVÉ TLAČIDLÁ - ZÁKLADNÉ ROZMERY PRE VŠETKY OKNÁ                 */
/* =================================================================== */

#CustomTitleBar QPushButton,
QMdiSubWindow #CustomTitleBar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    min-width: 45px;
    max-width: 45px;
    min-height: 30px;
    max-height: 30px;
}

/* Sivý hover pre bežné tlačidlá (minimalizácia, maximalizácia) */
#CustomTitleBar QPushButton#btn_minimize:hover,
#CustomTitleBar QPushButton#btn_maximize:hover,
#CustomTitleBar QPushButton#btn_about:hover,
#CustomTitleBar QPushButton#btn_update_github:hover,
QMdiSubWindow #CustomTitleBar QPushButton#btn_minimize:hover,
QMdiSubWindow #CustomTitleBar QPushButton#btn_maximize:hover {
    background-color: #E2E8F0;
}

/* =================================================================== */
/* IKONY PRE MINIMALIZÁCIU, MAXIMALIZÁCIU A OSTATNÉ                    */
/* =================================================================== */

QPushButton#btn_minimize {
    qproperty-icon: url("@ICON_DIR@/minimize_black.svg");
    qproperty-iconSize: 11px 11px;
}

QPushButton#btn_maximize {
    qproperty-icon: url("@ICON_DIR@/maximize_black.svg");
    qproperty-iconSize: 11px 11px;
}

QPushButton#btn_maximize[maximized="true"] {
    qproperty-icon: url("@ICON_DIR@/restore_black.svg");
    qproperty-iconSize: 11px 11px;
}

QPushButton#btn_about {
    qproperty-icon: url("@ICON_DIR@/about_black.svg");
    qproperty-iconSize: 16px 16px;
}

QPushButton#btn_update_github {
    qproperty-icon: url("@ICON_DIR@/update/github_update_black.svg");
    qproperty-iconSize: 16px 16px;
}

/* =================================================================== */
/* ZATVÁRACIE TLAČIDLO (HLAVNÉ AJ MDI OKNO - 100% ČERVENÉ + BIELY X)   */
/* =================================================================== */

/* 1. Kľudový stav: celková šírka 12 + 16 + 16 = 44px, výška 12 + 9 + 9 = 30px.
      Samotný krížik je zamknutý na presných 12x12 px! */
#CustomTitleBar QPushButton#btn_close,
QMdiSubWindow #CustomTitleBar QPushButton#btn_close,
QPushButton#btn_close {
    qproperty-icon: url("");
    background-color: transparent !important;
    border: none !important;
    border-radius: 0px !important;
    margin: 0px !important;
    min-width: 12px !important;
    max-width: 12px !important;
    min-height: 12px !important;
    max-height: 12px !important;
    padding: 9px 16px !important;
    image: url("@ICON_DIR@/close_black.svg");
}

/* 2. Hover stav: ČERVENÉ pozadie na celých 45x30 px a BIELY 12px krížik */
#CustomTitleBar QPushButton#btn_close:hover,
QMdiSubWindow #CustomTitleBar QPushButton#btn_close:hover,
QPushButton#btn_close:hover {
    background-color: #E81123 !important;
    image: url("@ICON_DIR@/close_white.svg") !important;
}

/* 3. Stlačený stav: tmavočervené pozadie a BIELY 12px krížik */
#CustomTitleBar QPushButton#btn_close:pressed,
QMdiSubWindow #CustomTitleBar QPushButton#btn_close:pressed,
QPushButton#btn_close:pressed {
    background-color: #C40E1E !important;
    image: url("@ICON_DIR@/close_white.svg") !important;
}

/* =================================================================== */
/* APLIKAČNÉ MENU                                                      */
/* =================================================================== */

QMenuBar,
QMenuBar#menu_bar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #CBD5E1;
    padding: 2px 4px;
    font-size: 12px;
}

QMenuBar::item,
QMenuBar#menu_bar::item {
    background-color: transparent;
    color: #1E293B;
    padding: 4px 9px;
    border-radius: 2px;
}

QMenuBar::item:selected,
QMenuBar#menu_bar::item:selected {
    background-color: #E2E8F0;
    color: #0F172A;
}

QMenu {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    padding: 4px 0px;
    border-radius: 2px;
}

QMenu::item {
    padding: 6px 28px 6px 22px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #0066CC;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 4px 8px;
}

/* =================================================================== */
/* ZÁLOŽKY (TABS)                                                      */
/* =================================================================== */

QTabWidget::pane {
    border: 1px solid #CBD5E1;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #E2E8F0;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-bottom: none;
    padding: 6px 16px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-width: 80px;
}

QTabBar::tab:hover:!selected {
    background-color: #EEF2F6;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #0066CC;
    font-weight: bold;
    border-bottom: 1px solid #FFFFFF;
    border-top: 2px solid #0066CC;
}

/* =================================================================== */
/* VSTUPNÉ POLIA                                                       */
/* =================================================================== */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    padding: 4px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #0066CC;
}

/* =================================================================== */
/* SPLASH SCREEN & PROGRESS BAR                                        */
/* =================================================================== */

#SplashScreen {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
}

QProgressBar {
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    text-align: center;
    color: #1E293B;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #0066CC;
}

#FramelessDialog {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
}


/* =================================================================== */
/* ZOZNAMY, TABUĽKY A STROMY (QListWidget, QTreeWidget, QTableWidget)   */
/* =================================================================== */

QListWidget, QTreeWidget, QTableWidget {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    padding: 2px;
    gridline-color: #E2E8F0;
}

QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #F1F5F9;
}

QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
    background-color: #F1F5F9;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #E2E8F0;
    color: #0066CC;
    font-weight: 600;
}

/* Hlavičky tabuliek a stromov */
QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-weight: 600;
    font-size: 11px;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #CBD5E1;
    border-right: 1px solid #E2E8F0;
}

/* =================================================================== */
/* ROZBAĽOVACIE ZOZNAMY (COMBOBOX) A ČÍSELNÍKY (SPINBOX)               */
/* =================================================================== */

QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    padding: 4px 8px;
    min-height: 20px;
}

/* QSpinBox MUSÍ mať vlastný štýl s veľkým pravým odskokom! */
QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 2px;
    padding: 4px 4px;
    padding-right: 25px; /* <--- TÝCHTO 25px VYTVORÍ MIESTO PRE ŠÍPKY */
    min-height: 20px;
}

QComboBox:focus, QSpinBox:focus {
    border: 1px solid #0066CC;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #E2E8F0;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    selection-background-color: #0066CC;
    selection-color: #FFFFFF;
}

/* =================================================================== */
/* SKUPINOVÉ BOXY (GROUPBOX)                                           */
/* =================================================================== */

QGroupBox {
    font-weight: 600;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background-color: #FFFFFF;
    color: #0066CC;
}